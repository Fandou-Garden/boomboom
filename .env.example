# DDT 本地服务端版环境变量样例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，切勿提交任何 Token 或密钥。
# 本项目不读取、不打印、不存储 GitHub 凭证。

# 只监听本机地址（默认 127.0.0.1）
DDT_HOST=127.0.0.1
DDT_PORT=8100

# 运行模式：server = 服务端版（房间/存档/强化）；offline = 仅保留既有 Go 契约用于排障
DDT_MODE=server

# 调试模式：开放 debug_* 与 fire 命令，仅用于自动化测试
DDT_DEBUG=0

# 固定模拟步长（毫秒），与既有 Go 服务端一致
DDT_TICK_MS=40

# 数据库：独立数据目录，WAL + 外键
DDT_DATA_DIR=./data
DDT_DB_PATH=./data/ddt.sqlite

# 前端目录（默认仓库内 dist/，站点版同一份文件）
# DDT_DIST_ROOT=./dist

# 固定弱机器人（只在服务端执行）
DDT_BOT_ANGLE=42
DDT_BOT_FORCE=1180
DDT_BOT_ATTACK_SCALE=0.35

# 交付强化规则（SIMPLE_LOCAL_V1）：原版素材 + 单机自定义强化规则，不可切换。
# +0 起、上限 +12；每次 1 颗真强化石 + 100×目标等级金币；成功率 100%；等级 +1；
# 不降级不损毁；基础伤害 = 未强化基础伤害 × (1 + 0.10 × 强化等级)。
# 原版强化链路研究证据仅存档在 docs/RULE_EVIDENCE.md，不参与运行时计算。

# 战后翻牌（单机自定义掉率，不代表官方概率）
DDT_REWARD_STONE_CHANCE=0.34
DDT_REWARD_WEAPON_CHANCE=0.12

# 奖励池：normal = 正常池（9 张整体洗牌，无固定卡位）；
# test = 独立测试池（强制 2 金币 + 1 真强化石 + 1 武器，仅供自动化验证）
DDT_REWARD_POOL=normal
